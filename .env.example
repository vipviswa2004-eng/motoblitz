# MotoBlitz Environment Variables
# Copy this file to .env and fill in your actual values

# ─── Supabase Configuration ──────────────────────────────────────────────────
# 1. Create a free project at https://supabase.com
# 2. Go to: Project Settings -> API
# 3. Copy URL and anon key below:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Google OAuth Setup in Supabase ──────────────────────────────────────────
# 1. Go to Google Cloud Console -> APIs & Services -> Credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized Redirect URI: https://<your-project-id>.supabase.co/auth/v1/callback
# 4. In Supabase Dashboard -> Authentication -> Providers -> Enable Google and paste Client ID & Client Secret

# ─── Cloudinary Configuration ─────────────────────────────────────────────────
# 1. Sign up at https://cloudinary.com
# 2. Copy Cloud Name from Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# 3. Go to: Settings -> Upload -> Upload presets -> Add upload preset (Mode: Unsigned, Name: motoblitz_products)
VITE_CLOUDINARY_UPLOAD_PRESET=motoblitz_products
